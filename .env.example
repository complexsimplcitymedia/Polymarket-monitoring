# Polymarket News Tracker - Environment Variables

# News API key from https://newsapi.org
NEWS_API_KEY=your_news_api_key

# Database URL
# For host PostgreSQL (port 5433) with pgvector:
DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5433/<dbname>
# For SQLite (fallback):
# DATABASE_URL=sqlite+aiosqlite:///./polymarket.db

# CORS origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Polymarket US API Credentials (Ed25519)
POLYMARKET_KEY_ID=your_polymarket_key_id
POLYMARKET_SECRET_KEY=your_polymarket_secret_key

# Polymarket CLOB credentials (fallback / Polygon EOA)
POLYMARKET_API_KEY=your_polymarket_api_key
POLYMARKET_SECRET=your_polymarket_secret
POLYMARKET_PASSPHRASE=your_polymarket_passphrase
POLYMARKET_PRIVATE_KEY=your_polygon_private_key

# AI Agents
# Claude is the primary analyst for the Debate Floor.
ANTHROPIC_API_KEY=your_anthropic_api_key
# Gemini is only used as a fallback if Anthropic is unset or erroring.
GEMINI_API_KEY=your_gemini_api_key
TAVILY_API_KEY=your_tavily_api_key

# Local LLM (opportunity hunter / parlay scanner) - needs no API key.
OLLAMA_BASE_URL=http://100.110.82.53:11434
LOCAL_LLM_MODEL=qwen2.5:3b
