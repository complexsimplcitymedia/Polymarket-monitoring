# Polymarket News Tracker - Environment Variables

# News API key from https://newsapi.org
NEWS_API_KEY=your_news_api_key

# Database URL
# For host PostgreSQL (port 5433) with pgvector:
DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5433/<dbname>
# For SQLite (fallback):
# DATABASE_URL=sqlite+aiosqlite:///./polymarket.db

# CORS origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Polymarket US API Credentials (Ed25519)
POLYMARKET_KEY_ID=your_polymarket_key_id
POLYMARKET_SECRET_KEY=your_polymarket_secret_key

# Polymarket CLOB credentials (fallback / Polygon EOA)
POLYMARKET_API_KEY=your_polymarket_api_key
POLYMARKET_SECRET=your_polymarket_secret
POLYMARKET_PASSPHRASE=your_polymarket_passphrase
POLYMARKET_PRIVATE_KEY=your_polygon_private_key

# AI Agents
# Claude is the primary analyst for the Debate Floor.
ANTHROPIC_API_KEY=your_anthropic_api_key
# Gemini is only used as a fallback if Anthropic is unset or erroring.
GEMINI_API_KEY=your_gemini_api_key
TAVILY_API_KEY=your_tavily_api_key

# Local LLM (opportunity hunter / parlay scanner) - needs no API key.
OLLAMA_BASE_URL=http://100.110.82.53:11434
LOCAL_LLM_MODEL=qwen2.5:3b

# Alerts: email delivery for "underpriced leader" alerts (leave SMTP_HOST or ALERT_EMAIL_TO empty to keep alerts in the app only)
ALERTS_ENABLED=true
ALERT_MAX_PRICE=0.50
ALERT_MIN_LEAD=5
ALERT_TRAIL_MAX_DEFICIT=8
ALERT_TRAIL_MAX_PRICE=0.30
ALERT_COOLDOWN_MINUTES=30
# Preferred: Hostinger Agentic Mail API token (sends from the mailbox the token belongs to)
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAILBOX_ID=
# Fallback: plain SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
ALERT_EMAIL_TO=

# Real-time layer (Node ingest + ticks worker)
TICKS_FLUSH_MS=250      # tick batch window in ms (300000 = every 5 minutes)
JUMP_POINTS=5           # a price move of this many points...
JUMP_WINDOW_MS=5000     # ...inside this many ms is recorded as a jump
# Optional: auth key for the ts-london sidecar. Leave empty to sign in through the login link in its logs.
TS_AUTHKEY=

# The AI inside the app (NanoGPT). Put your key here; leave empty to keep the AI off.
NANOGPT_API_KEY=
